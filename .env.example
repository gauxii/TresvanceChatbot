# Copy this file to .env and fill in real values. .env is gitignored — never
# commit actual credentials.

# Required to access the internal lead views (GET /leads, GET /api/leads).
# Without these set, admin endpoints fail closed (503), not open.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Comma-separated list of origins allowed to call the public /api/chat
# endpoint from a browser (CORS). Set this to the real site(s) embedding the
# widget in production, e.g. https://tresvance.com
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Local Ollama server and models.
OLLAMA_BASE=http://localhost:11434
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=llama3.2:3b

# Max visitor message length (characters) and Ollama request timeout (seconds).
MAX_MESSAGE_LENGTH=2000
OLLAMA_TIMEOUT_SECONDS=30
